# Keep collaboration documents readable in code review.
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cjs text eol=lf

# Preserve the exact bytes of the frozen prototype and its SHA-256 evidence.
prototype/current/** -text -eol

# Keep the R30 candidate's published bytes identical to its review receipt.
prototype/onboarding-chat-r30-candidate/** -text -eol

# Preserve user-selected prototype snapshots and their file manifests.
prototype/baselines/** -text -eol

# Preserve this delivered package byte-for-byte against its release manifest.
prototype/new5-welcome-stream-candidate/** -text -eol
releases/new5-main-20261027/** -text -eol
