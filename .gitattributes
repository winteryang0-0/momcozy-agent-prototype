# Keep collaboration documents readable in code review.
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cjs text eol=lf

# Preserve the exact bytes of the frozen prototype and its SHA-256 evidence.
prototype/current/** -text -eol

# Keep the R30 candidate's published bytes identical to its review receipt.
prototype/onboarding-chat-r30-candidate/** -text -eol
