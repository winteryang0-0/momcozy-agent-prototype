  "tests": [
    {
      "id": "T01",
      "steps": "每板切换 Today、Journal、Momcozy AI",
      "expected": "同一内容与相同导航状态"
    },
    {
      "id": "T02",
      "steps": "Today 与 Journal 分别切换保存、仅本地、失败、未知状态",
      "expected": "每个状态有不同标题、解释和建议下一步"
    },
    {
      "id": "T03",
      "steps": "AI 切换分析中与无法判断",
      "expected": "保留不确定性及证据边界"
    },
    {
      "id": "T04",
      "steps": "切换减少透明度和动效",
      "expected": "评审控件保留选中与可见焦点，玻璃有实体面替代"
    },
    {
      "id": "T05",
      "steps": "逐板对照喂养和尿布的功能入口、最近记录及时间线，并核对睡眠时间线与图标样张、哭闹入口与图标样张",
      "expected": "同板内同任务共用类别背景与图标色；喂养汇总只用喂养色，保存与 AI 结果不复用类别色"
    },
    {
      "id": "T06",
      "steps": "先在总览对照同一奶瓶、尿布、声波、睡眠图标与材质样张，再进四板观察底栏和日期控件",
      "expected": "四种图标绘制方式和四种玻璃材质有可感知差异；同一任务仍可被正确识别，文字不被亮斑遮挡"
    },
    {
      "id": "T07",
      "steps": "在四板分别开启减少透明度，观察底栏、日期控件、材质样张；再按浏览器能力检查无 backdrop-filter 的回退",
      "expected": "玻璃变为实体面，选中态和标签仍清楚；图标语义与任务颜色不随回退改变"
    }
  ],
