  "findings": [
    {
      "id": "VIS-CONT-01",
      "severity": "major",
      "status": "resolved",
      "location": "PAGE-chat / C10、C11 / 打开专项任务后的滚动定位",
      "observation": "修复前 task-final-360 图实际仍处于记录摘要，新任务标题和主操作不在可视区域；主操作者进一步确认路由滚动恢复回调覆盖了立即滚入任务的定位。",
      "impact": "用户点击听哭闹或看便便后可能看不到新任务，难以继续操作。",
      "fix": "把专项任务的 chat-stream 定位安排在路由恢复回调之后，并保持年龄和输入区位置。",
      "resolution": "当前360哭声和便便新图均完整显示任务标题与主操作；运行记录表明路由仍为 #/chat、外层滚动为0。",
      "evidence": [
        "reviews/screenshots/task-final-360.jpg",
        "reviews/task-scroll-fix.json",
        "reviews/screenshots/task-scroll-fixed-360.jpg",
        "reviews/screenshots/poop-scroll-fixed-360.jpg",
