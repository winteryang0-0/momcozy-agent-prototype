  "tests": [
    {
      "id": "T14-icons",
      "flow_id": "FLOW-onboarding",
      "state_ids": [
        "STATE-onboarding-identity",
        "STATE-onboarding-details",
        "STATE-onboarding-concerns",
        "STATE-onboarding-recommendations"
      ],
      "steps": [
        "依次查看身份、基础资料、关注和推荐页；核对图标与文本语义；检查窄屏留白与选中状态。"
      ],
      "expected": "角色、妈妈/宝宝、九个关注点和三项推荐使用对应图标，文字保持可读，焦点和选中状态不只依赖颜色。",
      "requirement_ids": [
        "R14-U01"
      ],
      "status": "acceptance-description-see-runtime-evidence"
    },
    {
      "id": "T14-onboarding",
      "flow_id": "FLOW-onboarding",
      "state_ids": [
        "STATE-onboarding-identity",
        "STATE-onboarding-details",
        "STATE-onboarding-concerns",
        "STATE-onboarding-recommendations"
      ],
      "steps": [
        "选择妈妈但不选阶段；资料页操作数字滚轮并填写生日；选择关注；查看独立推荐页并完成；刷新重进。"
      ],
      "expected": "身份必选，阶段选填；妈妈和宝宝同页；有效资料保存并可恢复。",
      "requirement_ids": [
        "R14-H02"
      ],
      "status": "acceptance-description-see-runtime-evidence"
    },
    {
      "id": "T14-stage-preservation",
      "flow_id": "FLOW-profile",
      "state_ids": [
        "STATE-profile-edit",
        "STATE-mine-normal"
      ],
      "steps": [
        "以空妈妈阶段、两名宝宝有效生日完成资料；进入妈妈资料不改直接保存；再切换孕前/孕期；刷新回看宝宝。"
      ],
      "expected": "空阶段不默认孕前；阶段变更不删除已有宝宝资料。",
      "requirement_ids": [
        "R14-F01"
      ],
      "status": "acceptance-description-see-runtime-evidence"
    },
    {
      "id": "T14-birthday-consistency",
      "flow_id": "FLOW-profile-invalid",
      "state_ids": [
        "STATE-profile-edit",
        "STATE-profile-error"
      ],
      "steps": [
        "分别在引导和宝宝资料输入当天、过去、留空和未来生日。"
      ],
      "expected": "当天、过去、留空均可保存；未来或无效日期都拒绝，使用本机当天而非固定记录演示日期。",
      "requirement_ids": [
        "R14-F02"
      ],
      "status": "acceptance-description-see-runtime-evidence"
    },
    {
      "id": "T14-hidden-baby",
      "flow_id": "FLOW-onboarding-invalid",
      "state_ids": [
        "STATE-onboarding-details",
        "STATE-onboarding-invalid"
      ],
      "steps": [
        "宝宝1有效，宝宝2未来日期；数量2→1→2，停留宝宝1尝试继续和完成；再测试阶段变化与刷新恢复。"
      ],
      "expected": "校验所有将保存的宝宝，定位错误宝宝与日期；不能通过隐藏字段保存非法日期。",
      "requirement_ids": [
        "R14-F03"
      ],
      "status": "acceptance-description-see-runtime-evidence"
    },
    {
      "id": "T14-deleted-unknown",
      "flow_id": "FLOW-delete-record",
      "state_ids": [
        "STATE-global-unknown",
        "STATE-record-delete-confirm",
        "STATE-records-normal"
      ],
      "steps": [
        "编辑已保存记录并模拟结果未知；关闭后删除原记录并确认；重新打开记一笔并核对旧请求；刷新回看。"
      ],
      "expected": "已删除记录不恢复，不产生重复记录；相关待处理请求和草稿不再提交删除对象。",
      "requirement_ids": [
        "R14-F04"
      ],
      "status": "acceptance-description-see-runtime-evidence"
    },
    {
      "id": "T14-task-timeline",
      "flow_id": "FLOW-task",
      "state_ids": [
        "STATE-assistant-chat",
        "STATE-task-ready",
        "STATE-task-result"
      ],
      "steps": [
        "长对话底部用关键词启动听哭闹；操作至结果；追加新消息和下一项任务；上滑回看并恢复历史。"
      ],
      "expected": "任务按发起次序留在对话中、状态原位推进；新任务可见，旧任务不会固定移到顶部。",
      "requirement_ids": [
        "R14-U02",
        "R14-F05"
      ],
      "status": "acceptance-description-see-runtime-evidence"
    },
    {
      "id": "T14-inline-isolation",
